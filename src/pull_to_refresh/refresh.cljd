(ns pull-to-refresh.refresh
  "Horizontal pull-to-refresh library for ClojureDart / Flutter.

  Default gesture: swipe right from the left edge to refresh.

  Public API:
  - `horizontal-refresh` — wrap a horizontal list with pull-to-refresh
  - `default-indicator-builder` — default left-edge indicator, overridable"
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:custom_refresh_indicator/custom_refresh_indicator.dart" :as refresh]
   ["dart:core" :as dc]
   [cljd.flutter :as f]))

;; ============================================================================
;; Options
;; ============================================================================

(def ^:private default-opts
  {:direction :right
   :reverse false
   :indicator-width 72.0
   :not-armed-color (m/Color 0xFF5C6BC0)
   :armed-color (m/Color 0xFF26A69A)
   :loading-color (m/Color 0xFF26A69A)
   :not-armed-text "Swipe to refresh"
   :armed-text "Release to refresh"
   :text-style (m/TextStyle
                .color m/Colors.white
                .fontWeight m/FontWeight.w600
                .fontSize 16.0)
   :trigger-mode refresh/IndicatorTriggerMode.onEdge
   :leading-scroll-indicator-visible false
   :trailing-scroll-indicator-visible false
   :background-color (m/Color 0xFFf8f4fc)})

(defn- normalize-opts [config]
  (let [opts (merge default-opts config)
        width (or (:indicator-width opts) 72.0)]
    (assoc opts
      :indicator-width width
      :offset-to-armed (or (:offset-to-armed opts) width))))

(defn- clamp01 [n]
  (cond
    (< n 0.0) 0.0
    (> n 1.0) 1.0
    :else n))

(defn- refresh-trigger
  "Swipe-right refresh uses the visual left edge.
  When the list is reversed, that edge is the trailing edge."
  [{:keys [trigger direction reverse]}]
  (or trigger
      (if (= direction :left)
        (if reverse
          refresh/IndicatorTrigger.leadingEdge
          refresh/IndicatorTrigger.trailingEdge)
        (if reverse
          refresh/IndicatorTrigger.trailingEdge
          refresh/IndicatorTrigger.leadingEdge))))

(defn- default-text-builder [direction]
  (fn [text style]
    (m/RotatedBox
     .quarterTurns (if (= direction :left) 1 3)
     .child
     (m/Text text
             .style style
             .softWrap false
             .maxLines 1))))

;; ============================================================================
;; Default indicator
;; ============================================================================

(defn default-indicator-builder
  "Build the default swipe-to-refresh indicator.

  Returns a fn of `[context child controller]`. Pass the result as
  `:indicator-builder`, or rely on `horizontal-refresh` to use this
  automatically.

  Recognized keys in `opts`:
  `:direction`, `:indicator-width`, `:offset-to-armed`,
  `:not-armed-color`, `:armed-color`, `:loading-color`,
  `:not-armed-text`, `:armed-text`, `:loading-text`,
  `:text-style`, `:text-builder`"
  [opts]
  (let [{:keys [direction indicator-width offset-to-armed
                not-armed-color armed-color loading-color
                not-armed-text armed-text loading-text
                text-style text-builder]}
        opts
        text-builder (or text-builder (default-text-builder direction))]
    (fn [_ child ^refresh/IndicatorController controller]
      (m/AnimatedBuilder
       .animation controller
       .builder
       (fn [_ _]
         (let [value (.-value controller)
               loading? (.-isLoading controller)
               armed? (.-isArmed controller)
               color (cond
                       loading? loading-color
                       armed? armed-color
                       :else not-armed-color)
               label (cond
                       loading? (or loading-text armed-text)
                       armed? armed-text
                       :else not-armed-text)
               dx (let [delta (* offset-to-armed value)]
                    (if (= direction :left) (- delta) delta))
               show-spinner? (and loading? (nil? loading-text))]
           (m/ClipRect
            .child
            (m/Stack
             .fit m/StackFit.expand
             .children
             [(m/Align
               .alignment (if (= direction :left)
                            m/Alignment.centerRight
                            m/Alignment.centerLeft)
               .child
               (m/Opacity
                .opacity (clamp01 value)
                .child
                (m/Container
                 .width indicator-width
                 .color color
                 .alignment m/Alignment.center
                 .child
                 (if show-spinner?
                   (m/SizedBox
                    .width 22.0
                    .height 22.0
                    .child
                    (m/CircularProgressIndicator
                     .strokeWidth 2.5
                     .color m/Colors.white))
                   (text-builder label text-style)))))
              (.translate
               m/Transform
               .offset (m/Offset dx 0.0)
               .child child)]))))))))

;; ============================================================================
;; Built-in horizontal list
;; ============================================================================

(defn- list-physics [physics]
  (or physics
      (m/AlwaysScrollableScrollPhysics
       .parent (m/ClampingScrollPhysics))))

(defn- default-separator [opts]
  (fn [_ _]
    (m/VerticalDivider
     .width (or (:separator-width opts) 0.0)
     .color (or (:separator-color opts) (m/Color 0xFFe2d6ce))
     .thickness (or (:separator-thickness opts) 1.0))))

(defn- horizontal-list [opts]
  (let [{:keys [background-color reverse item-count item-builder
                separator-builder box-shadow scroll-controller
                padding physics]}
        opts
        list-view
        (if (or separator-builder
                (:separator-color opts)
                (:separator-thickness opts)
                (:separator-width opts))
          (m/ListView.separated
           .controller scroll-controller
           .reverse (boolean reverse)
           .padding padding
           .scrollDirection m/Axis.horizontal
           .physics (list-physics physics)
           .itemBuilder item-builder
           .itemCount item-count
           .separatorBuilder (or separator-builder (default-separator opts)))
          (m/ListView.builder
           .controller scroll-controller
           .reverse (boolean reverse)
           .padding padding
           .scrollDirection m/Axis.horizontal
           .physics (list-physics physics)
           .itemBuilder item-builder
           .itemCount item-count))]
    (if (or background-color box-shadow)
      (m/DecoratedBox
       .decoration
       (m/BoxDecoration
        .color background-color
        .boxShadow (or box-shadow
                       [(m/BoxShadow
                         .blurRadius 2.0
                         .color m/Colors.black12
                         .spreadRadius 0.5
                         .offset (m/Offset 0.0 0.0))]))
       .child list-view)
      list-view)))

;; ============================================================================
;; Public API
;; ============================================================================

(defn- refresh-tree [controller opts child]
  (let [builder (or (:indicator-builder opts)
                    (default-indicator-builder opts))]
    (refresh/CustomRefreshIndicator
     .leadingScrollIndicatorVisible (:leading-scroll-indicator-visible opts)
     .trailingScrollIndicatorVisible (:trailing-scroll-indicator-visible opts)
     .triggerMode (:trigger-mode opts)
     .trigger (refresh-trigger opts)
     .offsetToArmed (:offset-to-armed opts)
     .controller controller
     .builder builder
     .onRefresh (:on-refresh opts)
     .child child)))

(defn horizontal-refresh
  "Horizontal pull-to-refresh. Default: swipe right from the left edge.

  Required:
    :on-refresh        fn [] -> Future

  Content — provide `:child` or both `:item-builder` and `:item-count`:
    :child             horizontal scrollable widget
    :item-builder      (fn [context index] widget)
    :item-count        list length
    :separator-builder (fn [context index] widget)
    :separator-color / :separator-thickness / :separator-width
    :scroll-controller
    :reverse           default false
    :padding
    :physics
    :background-color
    :box-shadow

  Gesture:
    :direction         `:right` (default, swipe right) or `:left`
    :trigger           IndicatorTrigger override
    :trigger-mode      default `onEdge`
    :offset-to-armed   pull distance in px; default = `:indicator-width`

  Indicator:
    :indicator-builder (fn [context child controller] widget)
    :indicator-width
    :not-armed-color / :armed-color / :loading-color
    :not-armed-text / :armed-text / :loading-text
    :text-style
    :text-builder      (fn [text style] widget)
    :indicator-controller

  Scrollbars:
    :leading-scroll-indicator-visible
    :trailing-scroll-indicator-visible"
  [config]
  (when-not (:on-refresh config)
    (throw (dc/Exception. "horizontal-refresh: :on-refresh is required")))
  (when-not (or (:child config)
                (and (:item-builder config) (:item-count config)))
    (throw (dc/Exception.
            "horizontal-refresh: provide :child, or both :item-builder and :item-count")))
  (let [opts (normalize-opts config)
        child (or (:child opts) (horizontal-list opts))]
    (if-let [ext (:indicator-controller opts)]
      (f/widget (refresh-tree ext opts child))
      (f/widget
       :managed [controller (refresh/IndicatorController.)]
       (refresh-tree controller opts child)))))
